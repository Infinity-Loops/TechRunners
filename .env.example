# ---------------------------------------------------------------------------
# TechRunners playtest — environment variables
# Copy to .env.local for development. NONE of these are exposed to the browser
# (no NEXT_PUBLIC_ prefixes) — every secret is read server-side only.
# ---------------------------------------------------------------------------

# Supabase — Project settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=report-media

# Admin panel
# ADMIN_PASSWORD gates the /admin console.
# SESSION_SECRET signs the login cookie (any long random string; falls back to
# ADMIN_PASSWORD if unset, but set a dedicated one in production).
ADMIN_PASSWORD=
SESSION_SECRET=

# Playtest download links shown on the landing page (leave blank to hide a card)
PLAYTEST_ANDROID_URL=https://play.google.com/apps/internaltest/4700705739206833188
PLAYTEST_IOS_URL=https://testflight.apple.com/join/H3af7gcc
PLAYTEST_STEAM_URL=https://store.steampowered.com/app/3659190/TechRunners/
