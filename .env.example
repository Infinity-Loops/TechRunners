# ---------------------------------------------------------------------------
# TechRunners playtest — environment variables
# Copy to .env.local for development.
# ---------------------------------------------------------------------------

# Supabase — Project Settings → API
SUPABASE_URL=
# Server-only. Required for the admin console + secure uploads (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=report-media

# Publishable (anon) key — safe to expose to the browser. Respects RLS.
# Used by the Supabase CLI and any future client-side reads.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Project ref (the subdomain in your Supabase URL).
SUPABASE_PROJECT_ID=

# Direct Postgres connection string — used by `npm run db:types` (needs Docker).
# Supabase Dashboard → Project Settings → Database → Connection string (URI).
SUPABASE_DB_URL=

# Admin panel
# ADMIN_PASSWORD gates the /admin console.
# SESSION_SECRET signs the login cookie (any long random string; falls back to
# ADMIN_PASSWORD if unset, but set a dedicated one in production).
ADMIN_PASSWORD=
SESSION_SECRET=

# Playtest download links shown on the landing page (leave blank to hide a card)
PLAYTEST_ANDROID_URL=https://play.google.com/apps/internaltest/4700705739206833188
PLAYTEST_IOS_URL=https://testflight.apple.com/join/H3af7gcc
PLAYTEST_STEAM_URL=https://store.steampowered.com/app/3659190/TechRunners/
